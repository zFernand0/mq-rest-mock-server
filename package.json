{
  "name": "mq-rest-mock-server",
  "version": "0.1.0",
  "description": "Stateful IBM MQ administration and messaging REST API mock for client integration tests",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "test:zowe-mq": "node scripts/test-zowe-mq.js",
    "test:watch": "node --test --watch test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/*.js --test-coverage-include=server.js --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 test/*.test.js",
    "check": "node scripts/check.js",
    "license:add": "node scripts/add-license-headers.js",
    "license:check": "node scripts/add-license-headers.js --dry-run",
    "validate": "npm run check && npm run license:check && npm run test:coverage"
  },
  "engines": { "node": ">=22" },
  "author": "Fernando Rijo Cedeno",
  "license": "Apache-2.0",
  "keywords": ["ibm", "mq", "rest", "mock", "mqsc", "integration-testing"],
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
